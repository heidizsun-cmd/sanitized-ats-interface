# Current local preview authentication.
# If omitted, server.py generates one-time credentials for each run.
ATS_DEMO_ADMIN_USERNAME=choose-a-local-username
ATS_DEMO_ADMIN_PASSWORD=choose-a-long-local-password

# Planned integrations below are not implemented in the current prototype.
# Purelymail mailbox proposed for recruiting communication.
# Do not put real passwords in frontend code.
PURELYMAIL_EMAIL=careers@your-domain.com
PURELYMAIL_USERNAME=careers@your-domain.com
PURELYMAIL_PASSWORD=replace-with-app-password-or-mailbox-password

# Incoming email sync.
IMAP_HOST=imap.purelymail.com
IMAP_PORT=993
IMAP_TLS=true

# Outbound email sending.
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_SECURE=true

# Alternative outbound option if your hosting provider requires STARTTLS.
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true

# Google Drive destination for parsed applicant resumes and email attachments.
GOOGLE_DRIVE_RESUME_FOLDER_ID=replace-with-drive-folder-id
GOOGLE_DRIVE_APPLICATIONS_FOLDER_ID=replace-with-drive-folder-id

# Planned backend options.
DATABASE_URL=postgres://user:password@localhost:5432/ats_demo
OPENAI_API_KEY=replace-when-parser-is-built
